# Server Configuration
PORT=3001

# Primary AI Model: Completely Free Local AI with Ollama (No API Key Required!)
# Quick Setup: winget install Ollama.Ollama -> ollama run qwen2.5:3b
AI_PROVIDER=ollama
# Used only when AI_PROVIDER is not set; a valid saved provider preference takes precedence.
DEFAULT_AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
# Local Development endpoint:
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Production / Netlify Cloud endpoint:
# Optional HTTPS authenticated gateway for remote Ollama. Never expose Ollama port 11434 publicly.
AI_API_BASE_URL=
OLLAMA_API_KEY=

# Optional cloud AI providers (selected only when explicitly configured)
# Google Gemini (Free API key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI & Groq Keys (Optional)
OPENAI_API_KEY=
GROQ_API_KEY=

# Web Search Provider: duckduckgo | tavily | serper | brave
# Note: DuckDuckGo requires NO API key and works immediately!
DEFAULT_SEARCH_PROVIDER=duckduckgo

# Optional Search API Keys
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# =========================================================
# FEATURE 1: AI IMAGE GENERATION (OpenAI DALL-E 3)
# =========================================================
# Provide OPENAI_API_KEY above to use official OpenAI DALL-E 3 image generation.
# If omitted, Mana AI uses Pollinations AI (Flux.1) out of the box with zero keys required!

# =========================================================
# FEATURE 2: AI VIDEO GENERATION (Luma Dream Machine / Replicate)
# =========================================================
# Luma Dream Machine API (Ray-2 / Ray-Flash-2 models)
# Get key from: https://lumalabs.ai/dream-machine/api
# Generates 5s–9s cinematic video clips at 720p/1080p
LUMA_API_KEY=

# Replicate API (Alternative Video Engine for Wan-2.1 / Minimax Video)
# Get token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# RunwayML API (Alternative Gen-3 Alpha Turbo)
# Get key from: https://runwayml.com/
RUNWAY_API_KEY=

# =========================================================
# FEATURE 3: LOCAL AI IMAGE GENERATION (ComfyUI)
# =========================================================
# Install ComfyUI: https://github.com/comfyanonymous/ComfyUI
# Start it: python main.py --listen 127.0.0.1 --port 8188
# Then select "Local ComfyUI" as Image Provider in Settings.
#
# Note: ComfyUI only works during LOCAL development (npm run dev).
# It cannot be reached from a Netlify cloud deployment.
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Checkpoint model filename (must be in ComfyUI/models/checkpoints/)
# Examples: v1-5-pruned-emaonly.safetensors, dreamshaper_8.safetensors
COMFYUI_MODEL=v1-5-pruned-emaonly.safetensors

# Optional: absolute path to a custom ComfyUI API workflow JSON
# Export from ComfyUI using: Settings → Export (API format)
COMFYUI_WORKFLOW_PATH=

# Generation parameters
COMFYUI_STEPS=20
COMFYUI_CFG_SCALE=7
